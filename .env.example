# Copy to .env and fill in. .env is git-ignored and NEVER committed.
#   cp .env.example .env
# Generate strong values:
#   openssl rand -base64 24   (passwords)
#   openssl rand -hex 16      (32-char Magento crypt key)

# ---- Public domain (must be a domain you control in Cloudflare) ----
MAGENTO_DOMAIN=magento.example.com
# Non-default admin path (security 3.6). Change from the example!
MAGENTO_ADMIN_PATH=admin_a1b2c3

# ---- Database ----
DB_PASSWORD=change-me-app-password
DB_ROOT_PASSWORD=change-me-root-password

# ---- Magento admin ----
MAGENTO_ADMIN_USER=admin
MAGENTO_ADMIN_EMAIL=admin@example.com
MAGENTO_ADMIN_PASSWORD=change-me-Admin123

# ---- Stable Magento encryption key (do NOT change after install) ----
MAGENTO_CRYPT_KEY=change-me-32-hex-characters-here

# ---- Adobe Commerce Marketplace auth keys (image build only) — OPTIONAL ----
# LEAVE EMPTY to build from the public Mage-OS mirror (https://mirror.mage-os.org),
# which serves the identical magento/* Open Source packages with no account.
# Fill these in only if you want the official repo.magento.com instead; keys are
# then created free at https://commercemarketplace.adobe.com -> Access Keys.
MAGENTO_MARKETPLACE_PUBLIC_KEY=
MAGENTO_MARKETPLACE_PRIVATE_KEY=

# ---- Cloudflare Tunnel token ----
# Create a tunnel (dashboard or CLI) and paste its token here. The tunnel's
# public hostname must map to MAGENTO_DOMAIN.
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Deploy target ----
# orbstack | minikube  (selects the values overlay)
CLUSTER_PROFILE=orbstack
NAMESPACE=magento
RELEASE=magento

# --- Grafana Cloud (OPTIONAL) ------------------------------------------------
# Only needed for scripts/install-monitoring.sh. See README "Monitoring".
GRAFANA_CLUSTER_NAME=magento-minikube
GRAFANA_CLOUD_TOKEN=
GRAFANA_PROM_URL=
GRAFANA_PROM_USER=
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
